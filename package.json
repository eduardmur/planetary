{
  "name": "planetary",
  "private": true,
  "version": "0.1.0",
  "description": "NASA's Planetary Fact Sheet redrawn as a set of engineering drawings, with interactive 3D views.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "data:fetch": "node scripts/fetch-nasa.mjs",
    "data:parse": "node scripts/parse-nasa.ts",
    "media": "node scripts/capture-media.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "node-html-parser": "^7.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0"
  }
}
